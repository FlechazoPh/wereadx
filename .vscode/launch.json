{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Deno: Run Server (dev)",
            "request": "launch",
            "type": "node",
            "program": "${workspaceFolder}/src/server.ts",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "deno",
            "runtimeArgs": [
                "run",
                "--inspect-wait",
                "--allow-all",
                "--unstable-kv"
            ],
            "args": [
                "local"
            ],
            "attachSimplePort": 9229
        },
        {
            "name": "Deno: Run Server (prod)",
            "request": "launch",
            "type": "node",
            "program": "${workspaceFolder}/src/server.ts",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "deno",
            "runtimeArgs": [
                "run",
                "--inspect-wait",
                "--allow-all",
                "--unstable-kv"
            ],
            "attachSimplePort": 9229
        },
        {
            "name": "Deno: Debug Current File",
            "request": "launch",
            "type": "node",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "deno",
            "runtimeArgs": [
                "run",
                "--inspect-wait",
                "--allow-all"
            ],
            "attachSimplePort": 9229
        }
    ]
}